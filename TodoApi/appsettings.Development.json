{
  "DetailedErrors": true,
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "TodoApi.Synchronization": "Information",
      "TodoApi.ExternalApi": "Information",
      "TodoApi.BackgroundServices": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "TodoContext": "Server=sqlserver;Database=Todos;User Id=sa;Password=Password123;TrustServerCertificate=True;"
  },
  "ExternalApi": {
    "BaseUrl": "http://localhost:3000",
    "TimeoutSeconds": 30,
    "MaxRetryAttempts": 3,
    "SourceId": "local-todo-api"
  },
  "Synchronization": {
    "Enabled": true,
    "IntervalMinutes": 5,
    "InitialDelayMinutes": 1,
    "MaxConsecutiveFailures": 5,
    "RunOnStartup": false
  }
}
